{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "C:/path/to/archiver/.venv/Scripts/archiver-plan-capture.exe"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "timeout": 60,
            "command": "C:/path/to/archiver/.venv/Scripts/archiver-index.exe --hook PreCompact"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "timeout": 60,
            "command": "C:/path/to/archiver/.venv/Scripts/archiver-index.exe --hook SessionEnd"
          }
        ]
      }
    ]
  }
}
